{
  "name": "agent-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Durable, human-in-the-loop agentic task pipeline (board -> plan -> approve -> implement -> test -> PR).",
  "engines": {
    "node": ">=22.14 <25"
  },
  "workspaces": [
    "packages/core",
    "packages/worker",
    "packages/api",
    "packages/web",
    "packages/mcp"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.check.json && npm run typecheck -w @pipeline/web",
    "test": "tsc -b && vitest run",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo .work .temporal",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run eval && npm run build -w @pipeline/web",
    "eval": "tsc -b && tsx evals/run.ts",
    "demo": "tsc -b && tsx scripts/demo.ts",
    "mcp": "node packages/mcp/dist/server.js",
    "lint": "eslint packages scripts evals",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json}\" \"scripts/**/*.ts\" \"evals/**/*.{ts,json}\" \"*.{json,md,yml,mjs,ts}\" \".github/**/*.yml\" \".agents/**/*.md\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,json}\" \"scripts/**/*.ts\" \"evals/**/*.{ts,json}\" \"*.{json,md,yml,mjs,ts}\" \".github/**/*.yml\" \".agents/**/*.md\"",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@temporalio/testing": "^1.17.2",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
