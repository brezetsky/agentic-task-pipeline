# ---------------------------------------------------------------------------
# Agent Pipeline configuration. Copy to `.env` and fill in only what you want.
#
# GRACEFUL DEGRADATION: with NONE of these set, the whole pipeline still runs
# end-to-end on mocks/stubs (mock board card, stub LLM plan, simulated
# PR; Git and tests run for real). Each real integration activates only when ITS vars are present.
# Never commit `.env`. Never paste secrets into chat.
# ---------------------------------------------------------------------------

# --- LLM (Google Gemini via Vercel AI SDK) ---------------------------------
# Get a free key (no credit card) at https://aistudio.google.com/apikey
# When set, real analyze/plan/codegen run; otherwise a deterministic stub is used.
GOOGLE_GENERATIVE_AI_API_KEY=
# Required with an API key. Choose an available model from https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=

# --- Task board (Trello) ----------------------------------------------------
# API key + token: https://trello.com/power-ups/admin  (or https://trello.com/app-key)
# List id: open a board, append `.json` to the URL, find the target list's id.
# When all three are set, real cards are pulled; otherwise a mock card is used.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# --- GitHub (real PRs) ------------------------------------------------------
# Fine-grained or classic PAT with `repo` scope: https://github.com/settings/tokens
# When all of token/owner/repo are set, a real PR is opened; otherwise simulated.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main

# --- Target repository the agent edits & tests ------------------------------
# Defaults to the bundled ./sandbox sample repo. Point at any local repo path,
# to operate on trusted code. Arbitrary clone URLs are unsupported.
TARGET_REPO_PATH=

# --- Temporal ---------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-pipeline

# --- App --------------------------------------------------------------------
API_PORT=3001
WEB_PORT=5173
MAX_REVISIONS=3

# API binds to loopback by default. Set 0.0.0.0 inside a container.
API_HOST=127.0.0.1
# Legacy shared all-permissions token; prefer named principals for separate permissions.
API_AUTH_TOKEN=
# JSON array: [{"id":"alice","tokenSha256":"<sha256 hex>","roles":["viewer"]}]
# Roles: viewer (read), operator (start), reviewer (approve/revise). Cannot combine with API_AUTH_TOKEN.
API_PRINCIPALS=
# Auth required by NODE_ENV=production; bypass ONLY for loopback demo containers.
API_ALLOW_UNAUTHENTICATED=false
# Docker isolation is the default. Image must be preloaded; prefer a digest in deployment.
EXECUTION_MODE=docker
TEST_RUNNER_IMAGE=node:22-slim
# Local host execution requires BOTH EXECUTION_MODE=local and this opt-in.
ALLOW_LOCAL_EXECUTION=false
# MCP uses its own explicit root and does not load .env.
# MCP_REPO_ROOT=/absolute/path/to/repository
